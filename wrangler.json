{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bastco-site-preview",
  "account_id": "dee9717c3a1fe6200333946668a0f12d",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "production": {
      "name": "bastco-site",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "bastco.org", "custom_domain": true }]
    }
  }
}
