{
  "name": "bastco-landing",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "blog:new": "node scripting/new-blog-post.mjs",
    "build": "astro build",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 4322 --env \"\"",
    "deploy:preview": "npm run build && wrangler deploy --env \"\"",
    "deploy": "npm run build && wrangler deploy --env production",
    "deploy:check": "npm run build && wrangler deploy --env production --dry-run",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test tests/build.test.mjs",
    "test:e2e": "playwright test",
    "test:deployment": "node scripting/smoke-deployment.mjs",
    "validate": "npm run check && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  }
}
