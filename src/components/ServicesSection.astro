---
interface Props {
  services: {
    title: string;
    slug: string;
    icon: string;
    description: string;
    highlights: string[];
  }[];
  title?: string;
}
const { services, title = 'Expertise that connects the dots.' } = Astro.props;
const orderedServices = [...services].sort((a, b) => {
  const order = [
    'cybersecurity-consulting',
    'infrastructure-automation',
    'enterprise-software',
    'ai-gateways',
  ];
  return order.indexOf(a.slug) - order.indexOf(b.slug);
});
---

<section id="services" class="section site-container">
  <div class="section-heading">
    <div><p class="eyebrow">What we do</p><h2>{title}</h2></div>
    <p>
      From identifying exposure to engineering the solution. Security is the
      thread through every engagement.
    </p>
  </div>
  <div class="services-grid">
    {
      orderedServices.map((service, index) => (
        <article class="service-card">
          <div class="card-number">
            <>
              <span>
                0{index + 1} /{' '}
                {service.icon === 'shield'
                  ? 'ASSESS'
                  : service.icon === 'cloud'
                    ? 'STRENGTHEN'
                    : service.icon === 'code'
                      ? 'BUILD'
                      : 'ENABLE'}
              </span>
              <span aria-hidden="true">↗</span>
            </>
          </div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <ul>
            {service.highlights.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
          <a class="text-link" href={`/services/${service.slug}`}>
            Explore{' '}
            {service.slug === 'cybersecurity-consulting'
              ? 'security consulting'
              : service.slug === 'infrastructure-automation'
                ? 'infrastructure'
                : service.slug === 'enterprise-software'
                  ? 'software engineering'
                  : 'AI gateways'}{' '}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
