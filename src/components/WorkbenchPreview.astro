---
const stages = [
  {
    name: 'Scope',
    cue: 'Set the context',
    title: 'Set the scope before you start.',
    description:
      'Define the authorized target and the question you want to answer.',
    label: 'Assessment context',
    value: 'Your target',
    detail: 'Authorization comes first. Target selection is not a sandbox.',
    items: [
      'Agree on the objectives',
      'Record the exclusions',
      'Review host permissions',
    ],
  },
  {
    name: 'Observe',
    cue: 'Follow the work',
    title: 'An investigation you can follow.',
    description:
      'Work through a security question in the terminal or local workbench.',
    label: 'Operator role',
    value: 'In the loop',
    detail:
      'Tools execute with the local host’s filesystem and network permissions.',
    items: [
      'Review requested actions',
      'Follow tool activity',
      'Inspect observations',
    ],
  },
  {
    name: 'Evidence',
    cue: 'Inspect the finding',
    title: 'Check the evidence behind a lead.',
    description:
      'Connect an observation to supporting evidence before drawing a conclusion.',
    label: 'Review state',
    value: 'Unverified',
    detail:
      'Model-generated observations require independent review and reproduction.',
    items: [
      'Inspect the evidence',
      'Reproduce the behavior',
      'Separate fact from inference',
    ],
  },
  {
    name: 'Report',
    cue: 'Prepare the handoff',
    title: 'Write a report someone else can review.',
    description:
      'Bring findings, evidence, and remediation notes into a report for human review.',
    label: 'Next step',
    value: 'Review',
    detail: 'An operator validates the work before acting on a finding.',
    items: [
      'Document the scope',
      'Connect findings to evidence',
      'Prioritize the next steps',
    ],
  },
];
---

<figure
  class="workbench"
  data-workflow
  aria-label="Interactive illustration of the Kifaru workflow"
>
  <div class="workbench-bar">
    <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span
    ><span>KIFARU / WORKFLOW EXPLORER</span>
  </div>
  <div
    class="workflow-controls"
    role="group"
    aria-label="Assessment stages"
    hidden
  >
    {
      stages.map((stage, index) => (
        <button
          type="button"
          data-stage={index}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span>0{index + 1}</span>
          {stage.name}
        </button>
      ))
    }
  </div>
  <div class="workflow-panels" aria-live="polite" aria-atomic="true">
    {
      stages.map((stage, index) => (
        <section
          class="workflow-panel"
          data-panel={index}
          aria-label={stage.name}
        >
          <p class="workbench-kicker">
            0{index + 1} / {stage.cue}
          </p>
          <>
            <h3>{stage.title}</h3>
            <p class="workflow-description">{stage.description}</p>
          </>
          <div class="workflow-signal">
            <>
              <span class="signal-orbit" aria-hidden="true">
                {['◎', '⌁', '◇', '↗'][index]}
              </span>
              <div>
                <>
                  <p>{stage.label}</p>
                  <strong>{stage.value}</strong>
                </>
              </div>
              <span class="signal-tag">ILLUSTRATION</span>
            </>
          </div>
          <ul class="workflow-checklist">
            {stage.items.map((item) => (
              <li>
                <span aria-hidden="true">↳</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="workflow-caution">{stage.detail}</p>
        </section>
      ))
    }
  </div>
  <figcaption class="workbench-foot">
    This walkthrough uses a mock interface. It does not run an assessment.
  </figcaption>
</figure>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-workflow]')
    .forEach((workbench) => {
      const controls =
        workbench.querySelector<HTMLElement>('.workflow-controls');
      const buttons = [
        ...workbench.querySelectorAll<HTMLButtonElement>('[data-stage]'),
      ];
      const panels = [
        ...workbench.querySelectorAll<HTMLElement>('[data-panel]'),
      ];
      const select = (index: number) => {
        buttons.forEach((button, i) =>
          button.setAttribute('aria-pressed', String(i === index)),
        );
        panels.forEach((panel, i) => {
          panel.hidden = i !== index;
        });
      };
      select(0);
      if (controls) controls.hidden = false;
      buttons.forEach((button, index) => {
        button.addEventListener('click', () => select(index));
        button.addEventListener('keydown', (event) => {
          let next: number;
          if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
          else if (event.key === 'ArrowLeft')
            next = (index + buttons.length - 1) % buttons.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = buttons.length - 1;
          else return;
          event.preventDefault();
          select(next);
          buttons[next].focus();
        });
      });
    });
</script>
