---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const {
  title,
  description,
  pubDate,
  author,
  heroImage,
  tags = [],
  category,
} = post.data;
const published = new Date(pubDate);
const formattedDate = published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const derivedSlug = post.id
  .replace(/\\/g, '/')
  .split('/')
  .pop()
  ?.replace(/\.[^/.]+$/, '');
if (!derivedSlug)
  throw new Error(`Unable to determine slug for blog entry "${post.id}"`);
const readingTime = Math.max(
  1,
  Math.round((post.body?.split(/\s+/).filter(Boolean).length ?? 0) / 200),
);
---

<article class="journal-card">
  <div class="journal-card-art" aria-hidden="true">
    {
      heroImage ? (
        <Image src={heroImage} alt="" width={800} loading="lazy" />
      ) : (
        <>
          <>
            <div class="editorial-rings">
              <>
                <i />
                <i />
                <i />
                <span>↗</span>
              </>
            </div>
            <span class="journal-card-topic">
              {category ?? tags[0] ?? 'Research & notes'}
            </span>
          </>
        </>
      )
    }
  </div>
  <div class="journal-card-body">
    <div class="article-meta">
      <time datetime={published.toISOString()}>{formattedDate}</time><span
        >{readingTime} min read</span>
    </div><h3><a href={`/blog/${derivedSlug}/`}>{title}</a></h3><p>
      {description}
    </p>{author && <p class="journal-card-author">By {author}</p>}<span
      class="journal-read"
      aria-hidden="true">Read article <span>↗</span></span>
  </div>
</article>
