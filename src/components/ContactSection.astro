---
import BookingPanel from './BookingPanel.astro';

interface Props {
  description?: string;
}
const {
  description = 'We can talk through an application assessment, infrastructure changes, or whether Kifaru fits your team’s needs.',
} = Astro.props;
---

<section id="contact" class="site-container contact-panel">
  <div>
    <p class="eyebrow">Contact Bastco</p><h2>
      Tell us what<br />you’re working on
    </h2><p>
      {description}
    </p><a class="text-link" href="/kifaru"
      >Learn about Kifaru <span aria-hidden="true">→</span></a>
  </div>
  <BookingPanel />
</section>
