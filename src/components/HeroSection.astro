---
import ProductShowcase from './ProductShowcase.astro';

interface Props {
  productPage?: boolean;
}
const { productPage = false } = Astro.props;
---

<section class="hero showcase-hero" aria-labelledby="showcase-title">
  <div class="site-container showcase-layout">
    <div class="intro">
      <p class="eyebrow">{productPage ? 'A BASTCO PRODUCT' : 'The Kifaru workbench'}</p>
      <h1 id="showcase-title">Kifaru, your<br /><em>AI red teammate.</em></h1>
      <p class="hero-description">
        {productPage
          ? 'Work in the terminal or the local workbench. Open a finding to see the records behind it, then decide what your team can report.'
          : 'Ask a question about an authorized assessment. Follow Kifaru’s work, inspect the evidence, and decide what belongs in the report.'}
      </p>
      <div class="actions">
        {productPage ? (
          <>
            <a class="button button-primary" href="https://install.bastco.org">Installation guide <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#workflow">Inspect the finding <span aria-hidden="true">↓</span></a>
          </>
        ) : (
          <>
            <a class="button button-primary" href="#kifaru">Try the demo <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="/kifaru">Explore Kifaru <span aria-hidden="true">→</span></a>
          </>
        )}
      </div>
    </div>
    <ProductShowcase id={productPage ? 'workflow' : 'kifaru'} initialView={productPage ? 'finding' : 'task'} />
  </div>
</section>

<style>
  .showcase-hero {
    padding-block: clamp(2.2rem, 6vw, 5.5rem);
    background: var(--page);
    border-bottom: 1px solid var(--line);
  }
  .showcase-layout {
    display: grid;
    grid-template-columns: minmax(0, .83fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }
  .intro h1 { font-size: clamp(3rem, 5vw, 4.8rem); }
  .intro .hero-description { max-width: 26rem; }
  @media (max-width: 860px) {
    .showcase-layout { grid-template-columns: minmax(0, 1fr); }
    .intro h1 { margin-block: 1rem; }
  }
</style>
