---
import { Image } from 'astro:assets';
import workspace from '../assets/images/kifaru-workspace.webp';
---

<section class="hero editorial-hero">
  <Image
    src={workspace}
    alt=""
    class="editorial-image"
    widths={[640, 960, 1440]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="site-container editorial-content">
    <p class="eyebrow">Security-led engineering</p>
    <h1>Build forward.<br /><em>Leave less<br />to chance.</em></h1>
    <p class="hero-description">
      Find the exposure. Build the fix. Security research and engineering,
      connected by Bastco.
    </p>
    <div class="actions">
      <a href="#contact" class="button button-primary"
        >Let’s talk <span aria-hidden="true">↗</span></a
      ><a href="/kifaru" class="button"
        >Meet Kifaru <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-pills" aria-label="Our focus">
      <span>◎ Security research</span><span
        >◇ Software &amp; infrastructure</span
      ><span>↗ Kifaru by Bastco</span>
    </div>
  </div>
</section>
