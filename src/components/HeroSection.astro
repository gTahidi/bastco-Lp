---
import fieldPlate from '../assets/images/kifaru-field-plate.svg?url';
---

<section class="hero field-hero">
  <div class="site-container field-layout">
    <div>
      <p class="eyebrow">Bastco field guide / 01</p>
      <h1>Kifaru, your<br /><em>AI red teammate.</em></h1>
      <p class="hero-description">
        Give Kifaru a question from your authorized assessment. It uses tools
        on your machine to help you investigate. You check the evidence and
        decide what goes in the report.
      </p>
      <div class="actions">
        <a href="/kifaru" class="button button-primary"
          >Explore Kifaru <span aria-hidden="true">→</span></a
        ><a href="#services" class="text-link"
          >Explore security services <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <figure class="field-plate">
      <img src={fieldPlate} alt="An ink drawing of a rhinoceros in profile." width="640" height="438" fetchpriority="high" />
      <figcaption><span>Plate 01 / Kifaru</span><span>Bastco field guide</span></figcaption>
    </figure>
  </div>
</section>

<style>
  .field-hero {
    background: var(--page);
    padding-block: clamp(3rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
  }
  .field-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .field-hero h1 {
    font-size: clamp(3rem, 5.7vw, 5.6rem);
    text-wrap: balance;
  }
  .hero-description { max-width: 30rem; }
  .field-plate {
    margin: 0;
    padding: .5rem;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 3px 5px 0 #e6e5dc;
    transform: rotate(-1.4deg);
  }
  .field-plate img { width: 100%; height: auto; display: block; }
  .field-plate figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: .85rem .6rem .35rem;
    font-size: .65rem;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .field-layout { grid-template-columns: minmax(0, 1fr); }
    .field-plate { max-width: 32rem; }
  }
</style>
