---
interface Props {
  repos: { title: string; description: string; url: string }[];
  title?: string;
}
const { repos, title = 'Built to be explored.' } = Astro.props;
---

<section id="opensource" class="section site-container">
  <div class="section-heading">
    <div><p class="eyebrow">Tools &amp; research</p><h2>{title}</h2></div><p>
      Explore security tooling and the ideas behind our work. Read the source,
      understand the approach.
    </p>
  </div>
  <div class="research-grid">
    {
      repos.map((repo, index) => (
        <article class="research-card">
          <span class="tag">0{index + 1} / Security tooling</span>
          <>
            <h3>{repo.title}</h3>
            <p>{repo.description}</p>
          </>
          <a
            class="text-link"
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Explore {repo.title} <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))
    }
  </div>
  <div class="actions" style="margin-top:2rem">
    <a class="text-link" href="/blog"
      >Read our research <span aria-hidden="true">→</span></a>
  </div>
</section>
