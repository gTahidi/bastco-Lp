---
import Brand from './Brand.astro';
interface Props {
  settings: { nav: { title: string; link: string }[] };
}
const { settings } = Astro.props;
---

<footer class="site-footer">
  <div class="site-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Brand />
        <p class="footer-description">
          Security-led engineering.<br />From understanding the threat to
          building what comes next.
        </p>
      </div>
      <div class="footer-group">
        <h2>Explore</h2>
        <nav aria-label="Footer navigation">
          {
            settings.nav
              .filter((item) => item.title !== 'Home')
              .map((item) => <a href={item.link}>{item.title}</a>)
          }
        </nav>
      </div>
      <div class="footer-group">
        <h2>Resources</h2>
        <nav aria-label="Resources">
          <a href="/security">Security &amp; responsible use</a>
          <a href="/privacy">Website privacy</a>
          <a
            href="https://github.com/orgs/Bastsec/"
            target="_blank"
            rel="noopener noreferrer"
            >GitHub <span aria-hidden="true">↗</span></a
          >
          <a
            href="https://install.bastco.org"
            target="_blank"
            rel="noopener noreferrer"
            >Kifaru installation <span aria-hidden="true">↗</span></a
          >
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Bastco. All rights reserved.</p>
      <p>Built with intent. Engineered for trust.</p>
    </div>
  </div>
</footer>
