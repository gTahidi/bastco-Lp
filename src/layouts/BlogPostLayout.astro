---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from './Layout.astro';
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  heroImage?: ImageMetadata;
  readingTime?: number;
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  author = 'BastCo Team',
  tags = [],
  heroImage,
  readingTime = 0,
} = Astro.props;
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
const published = new Date(pubDate);
const updated = updatedDate ? new Date(updatedDate) : undefined;
---

<Layout visual title={`${title} · Bastco Research`} description={description}>
  <article class="reading-page">
    <header class="site-container reading-header">
      <a class="text-link" href="/blog/">← All research &amp; notes</a><div
        class="article-meta"
      >
        <time datetime={published.toISOString()}>{formatDate(published)}</time>{
          readingTime > 0 && <span>{readingTime} min read</span>
        }
      </div><h1>{title}</h1><p class="reading-description">{description}</p><div
        class="reading-byline"
      >
        <span>By {author}</span>{
          updated && (
            <span>
              Updated{' '}
              <time datetime={updated.toISOString()}>
                {formatDate(updated)}
              </time>
            </span>
          )
        }
      </div>{
        tags.length > 0 && (
          <ul class="reading-tags" aria-label="Article topics">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    {
      heroImage && (
        <figure class="site-container reading-image">
          <Image
            src={heroImage}
            alt=""
            width={1280}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }
    <div class="site-container">
      <div class="bs-article reading-body"><slot /></div><nav
        class="reading-end"
        aria-label="Continue exploring"
      >
        <a class="button" href="/blog/">← More research &amp; notes</a><a
          class="text-link"
          href="/portfolio"
          >Explore Bastco’s capabilities <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </article>
</Layout>
