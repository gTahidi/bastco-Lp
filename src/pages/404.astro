---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Bastco"
  description="This page could not be found. Return to Bastco or explore Kifaru."
>
  <section class="site-container section">
    <p class="eyebrow">404 / Page not found</p><h1 class="display-heading">
      Let’s get you<br />back on track.
    </h1><p class="muted" style="margin:1.5rem 0 2rem">
      The page may have moved, or the address may be incorrect.
    </p><div class="actions">
      <a class="button button-primary" href="/"
        >Back to Bastco <span aria-hidden="true">→</span></a
      ><a class="button" href="/kifaru">Explore Kifaru</a>
    </div>
  </section>
</Layout>
