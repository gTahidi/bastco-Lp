---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WorkbenchPreview from '../components/WorkbenchPreview.astro';
import BookingPanel from '../components/BookingPanel.astro';
import PricingPreview from '../components/PricingPreview.astro';
import workspace from '../assets/images/kifaru-workspace.webp';
import models from '../assets/images/kifaru-models.webp';
---

<Layout
  visual
  title="Kifaru by Bastco — Your model. Your security workbench."
  description="A local-first security assessment harness. Bring your model-provider access, investigate in the terminal or local workbench, and review the evidence."
>
  <section class="hero editorial-hero kifaru-hero">
    <Image
      src={workspace}
      alt=""
      class="editorial-image"
      widths={[640, 960, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="site-container editorial-content">
      <p class="product-label"><span>A BASTCO PRODUCT</span> Kifaru</p>
      <p class="eyebrow">The local-first security harness</p>
      <h1>See the risk.<br /><em>Keep control.</em></h1>
      <p class="hero-description">
        Your model. Your workspace. A clearer path from security questions to
        evidence you can review.
      </p>
      <div class="actions">
        <a
          class="button button-primary"
          href="https://install.bastco.org"
          target="_blank"
          rel="noopener noreferrer"
          >Explore installation <span aria-hidden="true">↗</span></a
        ><a class="button" href="#workflow"
          >Try the workflow <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-pills">
        <span>◎ Local execution</span><span>◇ Your model-provider access</span
        ><span>↗ Human review</span>
      </div>
    </div>
  </section>
  <div class="site-container">
    <nav class="product-subnav" aria-label="On this page">
      <a href="#workflow">The experience</a><a href="#models">Your model</a><a
        href="#pricing">Proposed pricing</a
      ><a href="#boundaries">Operating boundaries</a>
    </nav>
  </div>
  <section id="workflow" class="section site-container experience-grid">
    <div class="experience-copy">
      <p class="eyebrow">A visual way to work</p><h2>
        Follow the question.<br />Find the evidence.
      </h2><p>
        Explore an authorized assessment in four stages. Choose a step to see
        what matters.
      </p><div class="experience-notes">
        <span>01 / Terminal &amp; local workbench</span><span
          >02 / Structured findings &amp; evidence</span
        ><span>03 / Human judgment throughout</span>
      </div><p class="small-note">
        An illustrative walkthrough, not the actual Kifaru interface. No target
        is scanned.
      </p>
    </div>
    <WorkbenchPreview />
  </section>
  <section id="models" class="site-container">
    <div class="model-story">
      <Image
        src={models}
        alt=""
        widths={[640, 960, 1440]}
        sizes="(max-width: 760px) 100vw, 85vw"
        loading="lazy"
      /><div class="model-story-copy">
        <p class="eyebrow">Bring what you already use</p><h2>
          Your models.<br />Your choice.
        </h2><p>
          Use your own supported model-provider access. Review provider settings
          before sharing assessment context.
        </p><div class="hero-pills">
          <span>Bring your access</span><span>Local host execution</span>
        </div>
      </div>
    </div>
  </section>
  <section
    class="section site-container cost-story"
    aria-labelledby="cost-heading"
  >
    <div>
      <p class="eyebrow">Two separate costs</p><h2 id="cost-heading">
        One harness.<br />Your inference bill.
      </h2><p>
        No bundled token allowance is proposed. Actual model costs depend on
        your provider, model, and workload—not a fixed price per assessment.
      </p>
    </div><div class="cost-ledger">
      <div>
        <span class="ledger-icon" aria-hidden="true">◇</span><div>
          <h3>Kifaru → Bastco</h3><p>
            The proposed license covers the security harness.
          </p>
        </div>
      </div><div>
        <span class="ledger-icon" aria-hidden="true">⌁</span><div>
          <h3>Model usage → your provider</h3><p>
            Inference is billed under your provider’s terms. Local models use
            your own compute.
          </p>
        </div>
      </div><p class="small-note">
        Usage budgets are reactive estimates, not guaranteed provider-side
        spending caps.
      </p>
    </div>
  </section>
  <PricingPreview />
  <section id="boundaries" class="section site-container">
    <div class="boundary-panel">
      <div>
        <p class="eyebrow">Keep the boundaries clear</p><h2>
          Local-first.<br />Not sandboxed.
        </h2>
      </div><div>
        <p>
          Use Kifaru only on targets you are authorized to assess. A selected
          target or working directory does not create a technical sandbox.
        </p><details>
          <summary>Before running an assessment</summary><ul>
            <li>
              Tools execute with the local host’s filesystem and network
              permissions. Use trusted workspaces.
            </li><li>
              The local dashboard’s authentication does not isolate agent
              execution.
            </li><li>
              Model-provider requests may transmit assessment context. Review
              data-handling requirements first.
            </li><li>
              Independently review and reproduce model-generated findings.
            </li>
          </ul>
        </details><a class="text-link" href="/security"
          >Security &amp; responsible use <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section id="demo" class="site-container contact-panel">
    <div>
      <p class="eyebrow">For people who care about the work</p><h2>
        Find your next<br />clear step.
      </h2><p>
        Talk through Kifaru, enterprise requirements, or a managed security
        engagement with Bastco.
      </p><a class="text-link" href="/services/cybersecurity-consulting"
        >Explore security consulting <span aria-hidden="true">↗</span></a>
    </div><BookingPanel />
  </section>
</Layout>
