---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import OpenSourceSection from '../components/OpenSourceSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import WorkbenchPreview from '../components/WorkbenchPreview.astro';
import opensource from '../data/opensource.json';

const offerings = [
  {
    title: 'Agentic red teaming',
    text: 'We build AI agent harnesses for authorized red team exercises. Your team reviews the evidence and confirms which controls need work.',
  },
  {
    title: 'Agentic blue teaming',
    text: 'We build agent harnesses that help analysts review alerts and test detections. Analysts decide what to escalate.',
  },
  {
    title: 'Automated scanning',
    text: 'We help automate recurring scans of approved assets and route findings to the teams that own them.',
  },
  {
    title: 'Continuous threat exposure management (CTEM)',
    text: 'We help you set up and run a program to rank exposures by risk, assign fixes, and verify the work.',
  },
];

const steps = [
  {
    title: 'Agree on the scope',
    text: 'We set the objectives, authorized assets, and limits with your team.',
  },
  {
    title: 'Fit the tools to the job',
    text: 'We agree on what to automate and which actions need a person’s approval.',
  },
  {
    title: 'Review the evidence',
    text: 'We check findings with your team and agree on what to fix first.',
  },
  {
    title: 'Verify the fixes',
    text: 'We retest agreed fixes and identify what still needs follow-up.',
  },
];
---

<Layout
  visual
  title="Kifaru, your AI red teammate | Bastco"
  description="Meet Kifaru, your AI red teammate for authorized assessments. Explore Bastco’s red and blue team harnesses, automated scanning, and exposure management services."
>
  <HeroSection />
  <section class="section site-container" id="kifaru">
    <div class="product-feature">
      <div class="product-copy">
        <p class="product-label"><span>FIELD NOTES</span> Inside Kifaru</p>
        <h2>From a question to a finding</h2>
        <p>
          What did the agent observe? What still needs checking? Step through
          a sample assessment in the workbench to see how a reviewer makes that call.
        </p>
        <div class="actions">
          <a class="button button-primary" href="/kifaru"
            >View Kifaru details <span aria-hidden="true">→</span></a
          ><a
            class="text-link"
            href="https://install.bastco.org"
            target="_blank"
            rel="noopener noreferrer"
            >Installation guide <span aria-hidden="true">↗</span></a
          >
        </div>
        <p style="font-size:.72rem;margin-top:1.5rem">
          For authorized assessments. Tools execute on your local host, not in a
          sandbox.
        </p>
      </div>
      <WorkbenchPreview />
    </div>
  </section>
  <section
    id="services"
    class="section site-container"
    aria-labelledby="services-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Bastco services</p>
        <h2 id="services-heading">Security testing and exposure management</h2>
      </div>
      <p>
        Bring us a control you need to test, an alert you can’t explain, or a
        backlog of scan findings. We’ll work with your team to scope the job.
      </p>
    </div>
    <div class="services-grid">
      {offerings.map((offering, index) => (
        <article class="service-card">
          <div class="card-number" aria-hidden="true"><span>0{index + 1}</span></div>
          <h3>{offering.title}</h3>
          <p>{offering.text}</p>
        </article>
      ))}
    </div>
    <div class="actions mt-8">
      <a class="button button-primary" href="#contact"
        >Discuss your scope <span aria-hidden="true">→</span></a
      >
      <a class="text-link" href="/portfolio"
        >See our engineering capabilities <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
  <section class="section section-rule">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How we work</p>
          <h2>From scope to retest</h2>
        </div>
        <p>
          We agree on what success looks like before work starts.
        </p>
      </div>
      <div class="process-grid">
        {
          steps.map((step, index) => (
            <div class="process-step">
              <>
                <span>0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <OpenSourceSection repos={opensource} />
  <AboutSection />
  <ContactSection description="Tell us what you need to test, monitor, or fix. We can discuss a scoped engagement or show you how Kifaru works." />
</Layout>
